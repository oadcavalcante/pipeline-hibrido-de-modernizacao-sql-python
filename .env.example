# ─── LLM ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
DEFAULT_LLM_MODEL=gpt-5.4-mini

# ─── Banco de dados principal ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pipeline:pipeline@localhost:5432/pipeline
DATABASE_URL_SYNC=postgresql+psycopg2://pipeline:pipeline@localhost:5432/pipeline

# ─── Langfuse (Observabilidade) ───────────────────────────────────────
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=http://localhost:3000   # ou https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# ─── App ──────────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
